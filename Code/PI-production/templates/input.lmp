# LAMMPS file (modified from XRA and DWL- annotated by WAF)

########## Set up simulation box ##########
units       metal       # Define default units we are using (grams/mole, angstroms, ps, eV, K, bar, etc.)
dimension   3           # Dimensionality of the system
boundary    p p p       # Periodic boundaries in all 3 dimensions
atom_style    atomic    # Style of atom data, "atomic" means we only have atom id, atom type, xyz position, and masses (no charges, molecules or bonds)
atom_modify   map yes   # Save a lookup table for atom IDs

newton        on        # Use newton's 3rd law to save compute (Fij = - Fji)

read_data   ./initconf.data     # Read in configuration from input file (MUST be LAMMPS data format, and contain masses)

########### Set up force field ############
pair_style    symmetrix/mace            # Style of model we are using
pair_coeff    * * XXXMODELPATHXXX H O   # Assign atom type 1 to H and 2 to O, then use coefficients from symmetrix .json output

############## Run parameters ###############

# Attach to ipi node (fix NAME TARGET i-pi SOCKETID PORT)
fix IPI1 all ipi XXXNIDXXX 31415

# Then, all run parameters (e.g. thermostat, initial velocities, etc.) as well
# as file outputs are handled directly by whatever is in the XML input.