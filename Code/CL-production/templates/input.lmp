# LAMMPS file (modified from XRA and DWL- annotated by WAF)

########## Set up simulation box ##########
units       metal       # Define default units we are using (grams/mole, angstroms, ps, eV, K, bar, etc.)
dimension   3           # Dimensionality of the system
boundary    p p p       # Periodic boundaries in all 3 dimensions
atom_style    atomic    # Style of atom data, "atomic" means we only have atom id, atom type, xyz position, and masses (no charges, molecules or bonds)
atom_modify   map yes   # Save a lookup table for atom IDs

newton        on        # Use newton's 3rd law to save compute (Fij = - Fji)

read_data   ./initconf.data     # Read in configuration from input file (MUST be LAMMPS data format, and contain masses)

########### Set up force field ############
pair_style    symmetrix/mace            # Style of model we are using
pair_coeff    * * XXXMODELPATHXXX H O   # Assign atom type 1 to H and 2 to O, then use coefficients from symmetrix .json output

########## Set up run parameters ###########
timestep 0.0005         # Timestep between simulation frames (NOTE: units metal -> this is in ps)

# Initialize velocity distribution
velocity all create XXXTEMPXXX 31415 dist gaussian

    # velocity TARGET create TEMP SEED dist DISTRIBUTION
    # TARGET: which group to apply the velocity to
    # create: tells you to create a new velocity distribution
    # TEMP: corresponding temperature for this velocity
    # SEED: seed for random number generator they use
    # dist: flag for lammps to provide a custom distribution (default is uniform)
    # DISTRIBUTION: the type of distribution you want (here we use a gaussian)
    # NOTE: will by default set the linear COM momentum to 0 (mom yes)

# Create NVT thermostat
fix NVT1 all nvt temp XXXTEMPXXX XXXTEMPXXX 0.05

    # fix LABEL TARGET nvt temp TSTART TFINAL TDAMP
    # LABEL: internal name for this fix
    # TARGET: which group to perform the fix on
    # nvt: the thermostat to use, here using Nose-Hoover chain (default chain length tchain 3)
    # temp: flag that tells LAMMPS you are providing temperature arguments
    # TSTART: initial temperature (units metal -> K)
    # TFINAL: final temperature (units metal -> K)
    # TDAMP: the thermostap damping temperature (generally 100xtimestep, again, this will be in ps)

############## File outputs ###############

#Open stream for trajectory output
dump DUMP1 all dcd XXXSTEPSIZEXXX traj-XXXOUTPREFXXX.dcd

    # dump LABEL TARGET FILETYPE STEPSIZE FILENAME
    # LABEL: internal name for this dump
    # TARGET: which group to perform the dump on
    # FILETYPE: type of file to output (here .dcd)
    # STEPSIZE: the frequency of dumps, expressed in frames
    # FILENAME: the output name for the dump file

# Unwrap trajectory- so that particles are not confined to the periodic cell (for diffusion)
dump_modify DUMP1 unwrap yes

# Checkpoint data throughout the simulation (cycles between a and b in case of mid-write crash)
restart 10000 chkpt-XXXOUTPREFXXX.a.restart chkpt-XXXOUTPREFXXX.b.restart

    # WARNING: If the checkpoint stride is longer than your simulation stride
    # (which it will be here, 10000 is big) then restarting from a checkpoint
    # file will double-write certain frames. For example, if we checkpoint every 
    # 50 frames and write every 10, a trajectory may look like (crashing at 70):
    # 10 20 30 40 50 60 70 |
    # Then, the checpoint file saves up to 50, so if we naively resume from the
    # checkpoint, our trajectory will look like:
    # 10 20 30 40 50 60 70 | 60 70 80 90 ...    # 60 and 70 are duplicated!!!
    # Where the | is the old crash. Options to fix this are to either write a ton
    # of checkpoint files matching simulation updates, or fix downstream.

# Add a timer to exit simulation gracefully (usually I do 5 mins before SLURM walltime)
timer timeout XXXSAFETIMEXXX every 50

# Run simulation until we hit NFRAMES- run NFRAMES upto
run XXXNSTEPSXXX upto

# Save final restart file to continue simulation if desired
write_restart final-XXXOUTPREFXXX.*.restart     